# Copy this file to .env and fill it in. Demo mode needs none of it.

# Required for real games: an OpenRouter key (https://openrouter.ai/keys).
# OPENROUTER_API_KEY works too, if you already have it set.
OPEN_ROUTER_KEY=sk-or-...

# Windows: keeps LiteLLM's file reads in UTF-8.
PYTHONUTF8=1

# Optional background music: a folder of your own .mp3 files (see config/music.yaml).
# MUSIC_DIR=/path/to/your/music
